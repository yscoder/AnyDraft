{
  "name": "any-draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @any-draft/web",
    "build": "npm run build -w @any-draft/web",
    "preview": "npm run preview -w @any-draft/web",
    "deploy": "npm run deploy -w @any-draft/web",
    "check": "npm run check --workspaces --if-present",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": {
    "name": "yusen",
    "email": "634206017@qq.com"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/yscoder/AnyDraft"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "prettier": "3.9.8"
  }
}
