{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "稿域",
  "version": "0.1.0",
  "identifier": "com.yscoder.anydraft",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-ui -w @any-draft/web",
    "devUrl": "http://localhost:28080",
    "beforeBuildCommand": "npm run build:tauri-ui -w @any-draft/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "稿域",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost blob:; font-src 'self' data:; img-src 'self' blob: data: https: http:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地优先的公众号 Markdown 创作工作台",
    "longDescription": "使用 Markdown 写作、实时预览公众号排版，并将草稿和图片保存在用户选择的本地目录。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
